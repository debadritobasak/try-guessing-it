import random
import string

def validate_length():
    while True:
        try:
            length = int(input("Enter password length: "))
            if length <= 0:
                print("Length must be greater than 0.")
            else:
                return length
        except ValueError:
            print("Invalid input! Enter a number.")

def generate_password(length, upper, number, special):
    chars = string.ascii_lowercase

    if upper == "yes":
        chars += string.ascii_uppercase
    if number == "yes":
        chars += string.digits
    if special == "yes":
        chars += string.punctuation

    password = ""
    for i in range(length):
        password += random.choice(chars)

    return password
def validate_input(prompt):
    while True:
        value = input(prompt).strip().lower()
        if value in {"yes", "no"}:
            return value
        print("Invalid input, please enter yes or no")

def display_password(password):
    print("\nGenerated Password:")
    print(password)

# Main Program
length = validate_length()

upper = validate_input("Include uppercase letters? (yes/no): ","If you press no then all characters will be in lowercase." )
number = validate_input("Include numbers? (yes/no): ")
special = validate_input("Include special characters? (yes/no): ")

password = generate_password(length, upper, number, special)
display_password(password)
